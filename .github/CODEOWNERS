# CODEOWNERS (PLT-131) : chemins PRIVILEGIES de kube-ops.
#
# Ce fichier est actif uniquement si le ruleset de `main` exige « Require review from Code Owners »
# (voir docs/platform/kube-ops-main-ruleset.json). Sans cette option, il reste documentaire.
#
# Regle de lecture : GitHub lit ce fichier sur la branche de BASE de la PR. Une PR ne peut donc pas
# s'accorder une exemption en modifiant ce fichier ; une modification de ce fichier reste soumise a
# l'approbation de @SmadjaPaul.
#
# Principe : une PR n'exige une approbation humaine que si elle TOUCHE un chemin ci-dessous. Les PR
# applicatives standard (k8s/applications/**, k8s/apps-generated/**, k8s/optional/**, charts
# applicatifs, documentation) ne sont pas listees et restent mergeables sans approbation.
#
# Un token de GitHub App (Backstage) ne peut pas satisfaire cette exigence : une App n'est pas un
# code owner. Son approbation ne compte donc pas pour ces chemins.
#
# Les motifs suivent la syntaxe gitignore ; la derniere regle correspondante l'emporte.

# --- Pipeline, CI et gouvernance du depot ---------------------------------------------------------
# Workflows (checks requis, workflow-integrity), actions, dependabot, instructions Copilot.
/.github/ @SmadjaPaul
# Point d'entree de tooling et garde du contrat de service (check v1-contract).
/.justfile @SmadjaPaul
/scripts/plan/ @SmadjaPaul
/tests/harness/service-contract-guard* @SmadjaPaul

# --- Golden paths : chaque changement se propage a toutes les PR generees ------------------------
/golden-paths/ @SmadjaPaul
/k8s/charts/platform-app/ @SmadjaPaul

# --- Bootstrap Argo CD : root app (cluster-admin via Argo) et AppProjects -------------------------
/k8s/bootstrap/ @SmadjaPaul
/k8s/clusters/*/bootstrap/ @SmadjaPaul
/k8s/clusters/*/apps/ @SmadjaPaul
# Definit destinations, namespaces et ressources cluster autorisees de chaque projet Argo.
/k8s/**/project.yaml @SmadjaPaul

# --- Authentik : OIDC, blueprints, clients --------------------------------------------------------
/k8s/infrastructure/auth/ @SmadjaPaul

# --- Securite et admission : politiques, VAP, exceptions, garde-fous ------------------------------
/k8s/infrastructure/security/ @SmadjaPaul
/k8s/clusters/*/guardrails/ @SmadjaPaul
/k8s/**/policy-exception*.yaml @SmadjaPaul
/k8s/**/validatingadmissionpolicy*.yaml @SmadjaPaul

# --- Identite et RBAC (tout fichier RBAC, quel que soit le dossier) ------------------------------
/k8s/**/rbac*.yaml @SmadjaPaul
/k8s/**/role*.yaml @SmadjaPaul
/k8s/**/clusterrole*.yaml @SmadjaPaul
/k8s/**/rolebinding*.yaml @SmadjaPaul
/k8s/**/clusterrolebinding*.yaml @SmadjaPaul
/k8s/clusters/*/agent-operator/ @SmadjaPaul
/k8s/infrastructure/controllers/argocd/ @SmadjaPaul

# --- Secrets d'infrastructure : ESO (ClusterSecretStore), ExternalSecret plateforme --------------
# Les ExternalSecret des applications (k8s/applications/**) ne sont PAS listes : voir le risque
# residuel dans docs/platform/backstage-github-app.md.
/k8s/infrastructure/controllers/external-secrets/ @SmadjaPaul
/k8s/clusters/*/external-secrets/ @SmadjaPaul
/k8s/**/*secret-store*.yaml @SmadjaPaul
/k8s/infrastructure/**/*external*secret*.yaml @SmadjaPaul
/k8s/clusters/**/*external*secret*.yaml @SmadjaPaul

# --- Exposition publique (tunnel, routes) ---------------------------------------------------------
/k8s/infrastructure/network/cloudflared/ @SmadjaPaul
/k8s/clusters/*/cloudflared/ @SmadjaPaul
