{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "platform.smadja.dev/v1 Application",
  "description": "Source unique du contrat. Le fichier app.yaml entier est le fichier de values du chart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.smadja.dev/v1" },
    "kind": { "const": "Application" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$",
          "description": "Nom unique : namespace svc-<name>, hostname <name>.smadja.dev."
        },
        "owner": {
          "type": "string",
          "pattern": "^(group:default/[a-z][a-z0-9-]*|user:default/paul)$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "source", "runtime", "exposure", "backup", "observability"],
      "properties": {
        "profile": {
          "enum": ["web", "web-postgres"],
          "description": "web = stateless (seul profil rendu). web-postgres est declare mais rejete tant que la base n'est pas reconciliee."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?@sha256:[a-f0-9]{64}$",
              "description": "repo:tag@sha256:<64 hex> obligatoire."
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replicas", "size", "port", "healthPath"],
          "properties": {
            "replicas": { "type": "integer", "minimum": 1, "maximum": 3 },
            "size": { "enum": ["small", "medium"], "description": "Table requests/limits dans le chart (templates/_helpers.tpl)." },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "healthPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$", "maxLength": 128, "description": "Chemin de sonde. Le point est accepté (ex. /.backstage/health/v1/liveness)." },
            "env": {
              "type": "object",
              "description": "Variables NON secrètes uniquement.",
              "maxProperties": 32,
              "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
              "additionalProperties": { "type": "string", "maxLength": 1024 }
            }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "auth"],
          "properties": {
            "mode": { "enum": ["private", "public"], "description": "private = Gateway internal. public = rejeté par le chart." },
            "auth": { "enum": ["none", "authentik"], "description": "authentik = rejeté par le chart (aucun mécanisme par route)." }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine"],
          "properties": {
            "engine": { "enum": ["postgres"] },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,30}$" }
          },
          "description": "Rejeté par le chart tant que pg-shared-homelab n'est pas réconcilié."
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]{0,3}Gi$" }
          },
          "description": "Rejeté par le chart (aucune capacité de stockage validée)."
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "enum": ["stateless"] }
          }
        },
        "secrets": {
          "type": "array",
          "description": "Clés du store doppler-cluster. ExternalSecret dans svc-<name>, Secret cible <name>-env injecté en envFrom. Chaque clé commence par <NAME>_ (NAME = metadata.name en majuscules, - remplacé par _) ; verifié par le chart.",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
        },
        "config": {
          "type": "object",
          "description": "Fichiers NON secrets, montés en lecture seule dans /etc/platform-config (ConfigMap <name>-config). Pas de clé privée (refusée par le chart).",
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
          "additionalProperties": { "type": "string", "maxLength": 65536 }
        },
        "egress": {
          "type": "object",
          "description": "Sorties explicites : FQDN exacts en HTTPS (port 443). Absent = aucune sortie hors DNS.",
          "additionalProperties": false,
          "required": ["https"],
          "properties": {
            "https": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "path"],
          "properties": {
            "metrics": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$", "maxLength": 128 }
          }
        }
      }
    }
  }
}
