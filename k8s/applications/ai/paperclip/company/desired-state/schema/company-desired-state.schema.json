{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smadja.dev/schemas/company-desired-state/v1",
  "title": "Company desired state",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "metadata", "spec"],
  "properties": {
    "schema": { "const": "company/desired-state/v1" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "CompanyDesiredState" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "const": "git" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["runtime", "organization", "roles", "capabilities", "decisionRights", "routing", "policies", "architectureDecisions"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["provisioningMode", "defaultHeartbeat", "environmentDefaults", "paperclipImport", "runtimeMutation"],
          "properties": {
            "provisioningMode": { "const": "reference_only" },
            "defaultHeartbeat": { "const": "OFF" },
            "environmentDefaults": {
              "type": "object",
              "required": ["DEFAULT_HEARTBEAT"],
              "properties": { "DEFAULT_HEARTBEAT": { "const": "OFF" } },
              "additionalProperties": false
            },
            "paperclipImport": { "const": "existing_safe_import" },
            "runtimeMutation": { "const": "forbidden" }
          },
          "additionalProperties": false
        },
        "organization": {
          "type": "object",
          "required": ["mission", "units"],
          "properties": {
            "mission": { "type": "string", "minLength": 1 },
            "units": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/unit" }
            }
          },
          "additionalProperties": false
        },
        "roles": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/role" }
        },
        "capabilities": {
          "type": "object",
          "required": ["decisionVocabulary", "lookup", "registry"],
          "properties": {
            "decisionVocabulary": {
              "type": "array",
              "prefixItems": [
                { "const": "REUSE" },
                { "const": "EXTEND" },
                { "const": "COMPOSE" },
                { "const": "ADAPTER" },
                { "const": "NEW_COMPONENT" },
                { "const": "NEW_SERVICE" },
                { "const": "BU_CANDIDATE" }
              ],
              "items": false
            },
            "lookup": { "$ref": "#/$defs/lookup" },
            "registry": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/registryEntry" }
            }
          },
          "additionalProperties": false
        },
        "decisionRights": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decisionRight" }
        },
        "routing": {
          "type": "object",
          "required": ["default", "routes"],
          "properties": {
            "default": { "$ref": "#/$defs/defaultRoute" },
            "routes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/route" }
            }
          },
          "additionalProperties": false
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policy" }
        },
        "architectureDecisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adr" }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "unit": {
      "type": "object",
      "required": ["id", "name", "leadRole", "roles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "leadRole": { "$ref": "#/$defs/id" },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["id", "title", "kind", "reportsTo", "bootstrapAgentRef", "capabilities", "decisionRights", "canApproveR2", "heartbeat"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "reportsTo": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "bootstrapAgentRef": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "decisionRights": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "canApproveR2": { "const": false },
        "heartbeat": { "const": "OFF" }
      },
      "additionalProperties": false
    },
    "lookup": {
      "type": "object",
      "required": ["requiredBeforeAddition", "requiredRecord", "requiredFields", "noMatchDefault", "structuralDecisions"],
      "properties": {
        "requiredBeforeAddition": { "const": true },
        "requiredRecord": { "const": "capability-evaluation" },
        "requiredFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "noMatchDefault": { "const": "NEW_COMPONENT" },
        "structuralDecisions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "registryEntry": {
      "type": "object",
      "required": ["id", "name", "ownerRole", "decision", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "ownerRole": { "$ref": "#/$defs/id" },
        "decision": { "type": "string", "enum": ["REUSE", "EXTEND", "COMPOSE", "ADAPTER", "NEW_COMPONENT", "NEW_SERVICE", "BU_CANDIDATE"] },
        "status": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decisionRight": {
      "type": "object",
      "required": ["id", "ownerRole", "scope", "requiresHumanApproval", "requiresCapabilityLookup", "requiresAdr"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ownerRole": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "minLength": 1 },
        "requiresHumanApproval": { "type": "boolean" },
        "requiresCapabilityLookup": { "const": true },
        "requiresAdr": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "defaultRoute": {
      "type": "object",
      "required": ["entryRole", "terminalRole", "defaultHeartbeat", "requiredEvidence"],
      "properties": {
        "entryRole": { "$ref": "#/$defs/id" },
        "terminalRole": { "$ref": "#/$defs/id" },
        "defaultHeartbeat": { "const": "OFF" },
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "when", "sequence", "decisionRight", "requiredCapabilityLookup", "requiredAdr"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "when": { "type": "string", "minLength": 1 },
        "sequence": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } },
        "decisionRight": { "$ref": "#/$defs/id" },
        "requiredCapabilityLookup": { "const": true },
        "requiredAdr": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["id", "rule", "enforcement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rule": { "type": "string", "minLength": 1 },
        "enforcement": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "adr": {
      "type": "object",
      "required": ["id", "title", "status", "decision", "rollback"],
      "properties": {
        "id": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "accepted" },
        "decision": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
