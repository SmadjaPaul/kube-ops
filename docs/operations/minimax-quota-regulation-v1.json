{
  "schemaVersion": "minimax-quota-regulation/v1",
  "status": "prepared-not-active",
  "provider": {
    "name": "minimax-token-plan",
    "quotaEndpoint": "https://www.minimax.io/v1/token_plan/remains",
    "credentialClass": "subscription-key-only",
    "payAsYouGoFallback": false,
    "windows": [
      {
        "id": "five-hour",
        "duration": "5h",
        "semantics": "rolling-from-first-use",
        "capacityUnit": "provider-reported",
        "reset": "independent"
      },
      {
        "id": "weekly",
        "duration": "7d",
        "semantics": "rolling-from-first-use",
        "capacityUnit": "provider-reported",
        "reset": "independent"
      }
    ],
    "observation": {
      "readOnly": true,
      "freshnessSeconds": 300,
      "unknownResponse": "deny",
      "percentToTokensConversion": "forbidden",
      "authenticatedSample": "not-yet-captured"
    }
  },
  "allocation": {
    "autonomousFraction": 0.7,
    "priorityFraction": 0.2,
    "reserveFraction": 0.1,
    "concurrency": 1,
    "reallocation": "only-within-provider-reported-remaining-capacity",
    "unusedCapacityWork": "never-start-work-to-consume-quota"
  },
  "admission": {
    "requiresBothWindows": true,
    "requiresFreshObservation": true,
    "requiresPerRunBudget": true,
    "quotaExhausted": "suspend-without-blind-retry",
    "quotaApiUnavailable": "deny",
    "provider429": "terminal-for-run-unless-explicitly-re-admitted",
    "duplicateReservation": "deny",
    "restart": "reconcile-from-durable-receipt-before-resume"
  },
  "smoothing": {
    "implementation": "native-agentgateway-token-bucket",
    "interval": "5m",
    "scope": "factory-canary",
    "active": false,
    "activationRequires": "authenticated-provider-capacity-mapping"
  },
  "runtimeBoundary": {
    "activeAgentgatewayConfigChanged": false,
    "activeBudgetRetained": "canary-daily-tokens/5000000/rolling-24h",
    "plT124": "suspended",
    "plT100": "off"
  },
  "rollback": {
    "kind": "git-revert",
    "runtimeMutationInThisChange": false,
    "stateMutation": false,
    "providerCredentialMutation": false
  }
}
