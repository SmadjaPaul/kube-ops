# Backend configuration for the NEW kube-ops cluster state in the existing OCI S3-compatible bucket.
# This is a fresh state key. Do NOT migrate, copy, import, or reuse any homelab-infra state.
#
# Credentials are supplied at execution time from Doppler:
#   AWS_ACCESS_KEY_ID     <- OCI_S3_ACCESS_KEY
#   AWS_SECRET_ACCESS_KEY <- OCI_S3_SECRET_KEY
#
# Usage:
#   tofu init -backend-config=backend-config.tfvars
#
bucket = "homelab-tfstate"
key    = "kube-ops/homeops-v2/terraform.tfstate"
region = "eu-paris-1"

endpoint = "https://axnvxxurxefp.compat.objectstorage.eu-paris-1.oraclecloud.com"

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true
use_lockfile                = true
