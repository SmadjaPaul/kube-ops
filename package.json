{
  "type": "module",
  "scripts": {
    "build": "cd website && npm run build",
    "install:all": "npm install && cd website && npm install",
    "check:v1-contract": "bash scripts/check-v1-active-contract.sh",
    "check:backup-contract": "bash scripts/backup-static-contract.sh",
    "check:gatekeeper-contract": "bash tests/harness/gatekeeper-audit-values-test.sh",
    "check:atlantis-dispatch": "bash scripts/check-atlantis-dispatch-contract.sh",
    "check": "npm run check:documentation && npm run check:v1-contract && npm run check:backup-contract && npm run check:gatekeeper-contract && npm run check:atlantis-dispatch && npm run check:agent-harness && npm run check:alerting-stage && npm run check:argocd-roots && npm run check:paperclip-retirement-stage && npm run check:inventory-graph && npm run check:resource-efficiency",
    "check:documentation": "node scripts/check-documentation-integrity.mjs && node --test tests/harness/documentation-integrity-test.mjs",
    "check:cluster-contract": "npm run check:v1-contract",
    "check:agent-harness": "bash scripts/check-agent-harness-contract.sh",
    "check:alerting-stage": "node --test tests/harness/alertmanager-ntfy-staged-test.mjs",
    "check:argocd-roots": "node --test tests/harness/argocd-generator-paths.test.mjs",
    "check:paperclip-retirement-stage": "node --test tests/harness/paperclip-retirement-stage.test.mjs",
    "check:inventory-graph": "node --test tests/harness/inventory-graph.test.mjs",
    "check:resource-efficiency": "bash tests/harness/resource-efficiency-dashboard-test.sh"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/cli": "21.2.4"
  },
  "engines": {
    "node": "v26.13.0",
    "npm": "12.2.1"
  }
}
