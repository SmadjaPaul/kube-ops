{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":enablePreCommit",
    "docker:enableMajor",
    "mergeConfidence:all-badges"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "timezone": "Europe/Paris",
  "schedule": [
    "* 0-7 * * *"
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 5,
  "rangeStrategy": "pin",
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "kustomize": {
    "managerFilePatterns": [
      "**/kustomization.yaml",
      "**/kustomization.yml",
      "**/kustomization.yaml.j2",
      "**/kustomization.yml.j2"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "k8s/**/values.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/",
        "/\\.tftpl$/",
        "/\\.tfvars$/",
        "/\\.yaml$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "(?<currentValue>[\\w+\\.\\-]*)['\\\",;]*\\s*#\\s?renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registry=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?",
        "(?<currentValue>[\\w+\\.\\-]*)['\\\",;]*\\s*#\\s?renovate:\\s+(?<datasource>docker)=(?<depName>\\S+)",
        "https://github.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/",
        "https://raw.githubusercontent.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile$/",
        "/Dockerfile\\..*$/"
      ],
      "matchStrings": [
        "ARG\\s+\\w+=(?<currentValue>[\\w+\\.\\-]*)['\\\"]?\\s*#\\s?renovate: (?<datasource>\\S+)=(?<depName>\\S+)\\s?(versioning=(?<versioning>\\S+))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "PLT-128 prefer qualified npm website update PRs over Docker digest backlog",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json",
        "website/package.json"
      ],
      "prPriority": 10
    },
    {
      "description": "PLT-128 defer non-security Docker digest PRs behind npm tooling",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "prPriority": -10
    },
    {
      "groupName": "Media containers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/onedr0p\\/.+$/",
        "/^ghcr\\.io\\/jellyfin\\/.+$/"
      ]
    },
    {
      "groupName": "Netbird",
      "matchPackageNames": [
        "/docker.io/netbirdio/.*/"
      ]
    },
    {
      "groupName": "Intel Device Plugins",
      "matchPackageNames": [
        "/intel-device-plugins/.*/"
      ]
    },
    {
      "groupName": "Cilium",
      "matchPackageNames": [
        "/cilium/.*/"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "provider",
        "required_provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "helm-values",
        "helm-requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "external-secrets",
      "matchPackageNames": [
        "/^ghcr.io/external-secrets//"
      ]
    },
    {
      "description": "Prevent automatic upgrades for Talos and Kubernetes versions in tofu/ - require manual review",
      "matchFileNames": [
        "/tofu/.*\\.(tf|tfvars|tftpl)$/"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "automerge": false,
      "automergeType": "pr",
      "schedule": [
        "before 10am on monday"
      ]
    },
    {
      "description": "PLT-128 preserve semver ranges for the commitlint pilot",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PLT-128 narrow pilot: root npm devDependencies patch/minor, SemVer >=1, mature releases, CI required",
      "groupName": "PLT-128 commitlint pilot",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "PLT-128 preserve ranges for static documentation tooling",
      "enabled": true,
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "remark",
        "remark-cli",
        "remark-frontmatter",
        "remark-lint",
        "remark-lint-no-dead-urls",
        "remark-lint-no-empty-sections",
        "remark-lint-no-undefined-references",
        "unist-util-visit"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PLT-131 Remark tooling discovery enabled; automerge held pending required documentation gate",
      "enabled": true,
      "automerge": true,
      "platformAutomerge": true,
      "groupName": "PLT-131 Remark tooling automerge pilot",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "remark",
        "remark-cli",
        "remark-frontmatter",
        "remark-lint",
        "remark-lint-no-dead-urls",
        "remark-lint-no-empty-sections",
        "remark-lint-no-undefined-references",
        "unist-util-visit"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automergeType": "pr"
    },
    {
      "description": "PLT-128 preserve ranges for the documentation TypeScript toolchain",
      "enabled": true,
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PLT-128 TypeScript documentation patch/minor automerge candidate; gated by docs-required",
      "enabled": true,
      "groupName": "PLT-128 TypeScript documentation toolchain",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "PLT-128 preserve ranges for Docusaurus runtime and plugins",
      "enabled": true,
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "matchPackageNames": [
        "@docusaurus/core",
        "@docusaurus/module-type-aliases",
        "@docusaurus/plugin-sitemap",
        "@docusaurus/preset-classic",
        "@docusaurus/tsconfig",
        "@docusaurus/types"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PLT-128 Docusaurus patch-only automerge candidate; gated by docs-required",
      "enabled": true,
      "groupName": "PLT-128 Docusaurus runtime and plugins",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "matchPackageNames": [
        "@docusaurus/core",
        "@docusaurus/module-type-aliases",
        "@docusaurus/plugin-sitemap",
        "@docusaurus/preset-classic",
        "@docusaurus/tsconfig",
        "@docusaurus/types"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr"
    },
    {
      "description": "PLT-128 preserve ranges for documentation UI libraries",
      "enabled": true,
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchPackageNames": [
        "@mdx-js/react",
        "clsx",
        "prism-react-renderer",
        "react-icons"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PLT-128 documentation UI libraries patch-only candidate; requires docs-required and 14-day maturation",
      "enabled": true,
      "groupName": "PLT-128 docs UI libraries patch-only",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchPackageNames": [
        "@mdx-js/react",
        "clsx",
        "prism-react-renderer",
        "react-icons"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "PLT-143 qualified ws-rewriter Rollout Caddy patch/minor AUTO",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "k8s/applications/ai/gpt-researcher/ws-rewriter-rollout.yaml"
      ],
      "matchPackageNames": [
        "caddy"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "PLT-140 Docusaurus website React runtime pair patch-only: docs-required build and typecheck",
      "groupName": "PLT-140 documentation React patch-only",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchPackageNames": [
        "react",
        "react-dom"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "PLT-140 low-risk docs UI search and typed animation patch only, docs-required gate",
      "groupName": "PLT-140 documentation UI extras patch-only",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "website/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchPackageNames": [
        "typed.js",
        "@easyops-cn/docusaurus-search-local"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "14 days",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/",
      "/k8s/.+\\.yml$/"
    ]
  },
  "platformAutomerge": false,
  "ignoreTests": false
}
