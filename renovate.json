{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "docker:enableMajor",
    "mergeConfidence:all-badges"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "automerge": false,
  "timezone": "Europe/Paris",
  "prConcurrentLimit": 8,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "kustomize": {
    "managerFilePatterns": [
      "**/kustomization.yaml",
      "**/kustomization.yml",
      "**/kustomization.yaml.j2",
      "**/kustomization.yml.j2"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "k8s/**/values.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/",
        "/\\.tftpl$/",
        "/\\.tfvars$/",
        "/\\.yaml$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "(?<currentValue>[\\w+\\.\\-]+)(?:@sha256:[a-f0-9]{64})?['\\\",;]*\\s*#\\s?renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registry=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?",
        "(?<currentValue>[\\w+\\.\\-]*)['\\\",;]*\\s*#\\s?renovate:\\s+(?<datasource>docker)=(?<depName>\\S+)",
        "https://github.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/",
        "https://raw.githubusercontent.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile$/",
        "/Dockerfile\\..*$/"
      ],
      "matchStrings": [
        "ARG\\s+\\w+=(?<currentValue>[\\w+\\.\\-]*)['\\\"]?\\s*#\\s?renovate: (?<datasource>\\S+)=(?<depName>\\S+)\\s?(versioning=(?<versioning>\\S+))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "CI load: non-critical docker patch/minor grouped in one weekend batch (sensitive components excluded, handled by PLT-172 rules)",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/cilium/",
        "!/talos/",
        "!/longhorn/",
        "!/authentik/",
        "!/cloudnative-pg/",
        "!/cnpg/",
        "!/barman/",
        "!/velero/",
        "!/argo-cd/",
        "!/argoproj/",
        "!/cert-manager/",
        "!/external-secrets/",
        "!/cloudflare/",
        "!/proxmox/",
        "!/moodiness\\/polyfin/"
      ],
      "groupName": "docker non-critical minor and patch",
      "schedule": [
        "* 0-7 * * 0,6"
      ]
    },
    {
      "description": "CI load: helm/kustomize non-critical patch/minor grouped in one weekend batch",
      "matchManagers": [
        "helm-values",
        "helm-requirements",
        "helmv3",
        "kustomize"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/cilium/",
        "!/talos/",
        "!/longhorn/",
        "!/authentik/",
        "!/cloudnative-pg/",
        "!/cnpg/",
        "!/barman/",
        "!/velero/",
        "!/argo-cd/",
        "!/argoproj/",
        "!/cert-manager/",
        "!/external-secrets/",
        "!/cloudflare/",
        "!/proxmox/",
        "!/moodiness\\/polyfin/"
      ],
      "groupName": "helm non-critical minor and patch",
      "schedule": [
        "* 0-7 * * 0,6"
      ]
    },
    {
      "description": "Image runner ARC : Node, tofu et les autres outils de images/arc-ci-runner/mise.toml dans un seul lot (meme calendrier que les depots), le workflow arc-ci-runner-drift rattrape le reste",
      "matchManagers": [
        "mise",
        "npm"
      ],
      "matchFileNames": [
        "images/arc-ci-runner/**"
      ],
      "groupName": "outils de l'image runner ARC",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Image runner ARC : pnpm suit packageManager de website (source de verite par depot), pas Renovate ; arc-ci-runner-drift ajoute la version d'un depot qui change (PLT-484)",
      "matchManagers": [
        "mise"
      ],
      "matchFileNames": [
        "images/arc-ci-runner/**"
      ],
      "matchPackageNames": [
        "pnpm"
      ],
      "enabled": false
    },
    {
      "description": "PLT-399 pin container images in Kubernetes manifests by digest (deterministic revert)",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "k8s/**"
      ],
      "pinDigests": true
    },
    {
      "description": "Gel Factory/Mastra : aucune mise a jour (decision 22/11)",
      "matchFileNames": [
        "mastra-factory/**",
        "factory-platform/**",
        "k8s/**/factory-platform/**",
        "k8s/**/optio/**"
      ],
      "enabled": false
    },
    {
      "description": "Abandonnes : plus de mises a jour pour Atlantis, Codex, Hetzner",
      "matchPackageNames": [
        "/atlantis/",
        "/codex/",
        "/hetzner/"
      ],
      "enabled": false
    },
    {
      "description": "Polyfin : revue manuelle apres audit image (pas de groupe)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/moodiness/polyfin"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "npm : docs et outillage, un lot",
      "groupName": "npm (docs et outillage)",
      "matchManagers": [
        "npm"
      ]
    },
    {
      "description": "GitHub Actions : un lot",
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "description": "Images conteneurs sans etat : un lot (digests, patch, minor)",
      "groupName": "Images conteneurs",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "kubernetes",
        "dockerfile",
        "custom.regex",
        "helm-values",
        "kustomize"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin",
        "patch",
        "minor"
      ]
    },
    {
      "description": "Charts Helm non critiques : un lot",
      "groupName": "Charts Helm",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "description": "Providers OpenTofu : un lot patch/minor",
      "groupName": "Providers OpenTofu",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "provider",
        "required_provider"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "description": "Majeures : PR individuelles, jamais groupees",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "description": "Composant critique Cilium : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/cilium/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique CloudNativePG : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/cloudnative-pg|cnpg|barman/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Authentik : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/authentik/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique External Secrets : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/external-secrets/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Argo CD : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/argo-cd|argoproj/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Longhorn : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/longhorn/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Velero : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/velero/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique kube-prometheus-stack : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/kube-prometheus-stack/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique cert-manager : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/cert-manager/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Talos : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/talos/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Proxmox : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/proxmox/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    },
    {
      "description": "Composant critique Kubernetes : PR individuelle, 7 jours, revue",
      "groupName": null,
      "matchPackageNames": [
        "/kubernetes\\/kubernetes/"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "separateMajorMinor": true
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/",
      "/k8s/.+\\.yml$/"
    ]
  },
  "platformAutomerge": false,
  "ignoreTests": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null
  },
  "rebaseWhen": "conflicted"
}
