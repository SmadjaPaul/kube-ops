# Dedicated state boundary for GitHub administration.
#
# This backend is the dedicated GitHub state boundary. Never point it at
# homelab-tfstate or inject the operator-wide infrastructure/prd credentials
# into Atlantis.
terraform {
  backend "s3" {
    bucket                      = "homelab-github-tfstate"
    key                         = "github/terraform.tfstate"
    region                      = "eu-paris-1"
    endpoint                    = "https://axnvxxurxefp.compat.objectstorage.eu-paris-1.oraclecloud.com"
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = true
    use_lockfile                = true
  }
}
